BACKEND_IMAGE=ghcr.io/duongtran12/distributed-url-shortener-backend:1.0.0
FRONTEND_IMAGE=ghcr.io/duongtran12/distributed-url-shortener-frontend:1.0.0
BACKEND_REPLICAS=2
BACKEND_MEMORY_LIMIT=768M

POSTGRES_DB=url_shortener
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
RABBITMQ_USERNAME=url_shortener
RABBITMQ_PASSWORD=replace_with_a_long_random_broker_password

JWT_SECRET=replace_with_base64_encoded_32_byte_secret
VISITOR_HASH_SECRET=replace_with_an_independent_random_secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_grafana_password

PUBLIC_BASE_URL=https://short.example.com/
BIND_ADDRESS=0.0.0.0
APP_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_FROM_ADDRESS=no-reply@short.example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true

REFRESH_TOKEN_EXPIRATION=P30D
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=PT1M
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_REDIRECT_REQUESTS=60
RATE_LIMIT_API_REQUESTS=120
